# PostgreSQL connection for import history, saved mappings and settings.
# The database is created automatically on first start if it does not exist.
# On Vercel: set by the Neon (Postgres) integration in the project's Storage tab.
DATABASE_URL=postgresql://postgres@localhost:5432/sacco_import

# Where uploaded originals and generated files are kept (outside the public web folder).
# Used on your own computer/server. On Vercel files go to Vercel Blob instead (see below).
STORAGE_DIR=./storage

# Vercel Blob (only on Vercel): set automatically when a PRIVATE Blob store is connected in the project's Storage tab.
# When it is set, all files are stored there as private files and the browser uploads large files straight to it.
# BLOB_READ_WRITE_TOKEN=
